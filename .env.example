# URL proyek Supabase
# Project Settings > API > Project URL
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Anon / publishable key
# Project Settings > API > Publishable key (atau anon public key)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.xxxxxxxxxxxxxxxxxxxx

# Service role key (HANYA untuk server, jangan pernah dipakai di browser)
# Project Settings > API > Secret key / service_role
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.xxxxxxxxxxxxxxxxxxxx

# URL aplikasi untuk redirect email verifikasi
NEXT_PUBLIC_SITE_URL=http://localhost:3000
